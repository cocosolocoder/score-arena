{"step":1,"type":"start-service","id":"scorearena","purpose":"启动真实服务，读取含正常房间、七列异常字段和非对象记录的业务数据。","command":"go run . serve --host 127.0.0.1 --port 21103 --data-dir data","displayStartedAt":"2026-10-05T16:31:05.915822+00:00","executedAt":"2026-10-05T16:31:07.610218+00:00","endedAt":"2026-10-05T16:31:07.713084+00:00","cwdBefore":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","cwdAfter":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","exitCode":0,"timedOut":false,"started":true,"ready":true,"readyPort":21103,"processId":158569,"processGroupId":158569,"serviceLog":"/opt/gsb-production/workspaces/coco/prod-17/D/task024/recordings/prod-17-024-a-r1/services/scorearena-001.log","output":"ScoreArena listening on http://127.0.0.1:21103\n","status":"Service scorearena ready on 127.0.0.1:21103","shell":"bash","shellExecutable":"/usr/bin/bash","shellVersion":"5.2.21","nativeArgumentPassing":"argv","outputBase64":"U2NvcmVBcmVuYSBsaXN0ZW5pbmcgb24gaHR0cDovLzEyNy4wLjAuMToyMTEwMwo="}
{"step":2,"type":"command","purpose":"展示真实 200 响应与原始旧记录、异常字段及附带字段。","command":"curl -i --config list.curl","displayStartedAt":"2026-10-05T16:31:10.528191+00:00","executedAt":"2026-10-05T16:31:12.663784+00:00","endedAt":"2026-10-05T16:31:12.669781+00:00","cwdBefore":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","cwdAfter":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","exitCode":0,"timedOut":false,"started":true,"processId":159942,"processGroupId":159942,"shell":"bash","shellExecutable":"/usr/bin/bash","shellVersion":"5.2.21","nativeArgumentPassing":"argv","output":"HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nDate: Mon, 05 Oct 2026 16:31:12 GMT\r\nContent-Length: 662\r\n\r\n{\"rooms\":[{\"id\":\"morning-room\",\"name\":\"\\u003cb\\u003e晨间\\u003c/b\\u003e \\\"棋友\\\" \\u0026 老友\",\"game\":\"gomoku\",\"capacity\":2,\"turnSeconds\":0,\"status\":\"waiting\",\"createdAt\":\"2026-02-03T08:30:00Z\",\"note\":{\"场次\":\"晨间\"},\"tags\":[\"老友\"]},{\"id\":{\"编号\":\"周末场\"},\"name\":[\"周末棋局\"],\"game\":{\"规则\":\"ludo\"},\"capacity\":[4],\"turnSeconds\":{\"秒数\":60},\"status\":[\"waiting\"],\"createdAt\":{\"时间\":\"2026-02-04T08:00:00Z\"},\"note\":\"保留旧记录\"},null,{\"id\":\"evening-room\",\"name\":\"\\u0026lt;晚间\\u0026gt; \\u0026amp; 棋友\",\"game\":\"ludo\",\"capacity\":3,\"turnSeconds\":60,\"status\":\"playing\",\"createdAt\":\"2026-02-04T23:15:00Z\",\"extra\":{\"赛程\":[1,2]}}]}\n","outputBase64":""}
{"step":3,"type":"command","purpose":"提交含标签和实体样式纯文本名称的合法房间，展示真实创建状态码、编号与配置。","command":"curl -i --config create.curl","displayStartedAt":"2026-10-05T16:31:15.190541+00:00","executedAt":"2026-10-05T16:31:17.206293+00:00","endedAt":"2026-10-05T16:31:17.218936+00:00","cwdBefore":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","cwdAfter":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","exitCode":0,"timedOut":false,"started":true,"processId":161343,"processGroupId":161343,"shell":"bash","shellExecutable":"/usr/bin/bash","shellVersion":"5.2.21","nativeArgumentPassing":"argv","output":"HTTP/1.1 201 Created\r\nContent-Type: application/json; charset=utf-8\r\nDate: Mon, 05 Oct 2026 16:31:17 GMT\r\nContent-Length: 233\r\n\r\n{\"id\":\"6e1259440d2488a6d1859c71ee173620\",\"name\":\"\\u003cb\\u003e晚间新局\\u003c/b\\u003e \\\"棋友\\\" \\u0026amp;\",\"game\":\"ludo\",\"capacity\":4,\"turnSeconds\":60,\"status\":\"waiting\",\"visibility\":\"public\",\"createdAt\":\"2026-10-05T16:31:17Z\"}\n","outputBase64":""}
{"step":4,"type":"command","purpose":"保留浏览器原始 DOM 和 stderr，观察七列异常提示、状态徽标、准确跳过数量及追加的新房间。","command":"${CHROME_PATH:-/usr/bin/google-chrome} --headless --no-sandbox --disable-gpu --disable-dev-shm-usage --dump-dom --virtual-time-budget=3000 http://127.0.0.1:21103/","displayStartedAt":"2026-10-05T16:31:20.263650+00:00","executedAt":"2026-10-05T16:31:22.731062+00:00","endedAt":"2026-10-05T16:31:23.265367+00:00","cwdBefore":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","cwdAfter":"/opt/gsb-production/workspaces/coco/prod-17/verification/evaluation-rounds/1/record/prod-17-024/a","exitCode":0,"timedOut":false,"started":true,"processId":163140,"processGroupId":163140,"shell":"bash","shellExecutable":"/usr/bin/bash","shellVersion":"5.2.21","nativeArgumentPassing":"argv","output":"<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ScoreArena · 桌面规则游戏与赛事管理</title>\n<style>\n  :root { color-scheme: light; }\n  body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.7; color: #1f2933; }\n  h1 { margin-bottom: .25rem; }\n  .sub { color: #52606d; margin-top: 0; }\n  h2 { margin-top: 2.5rem; border-bottom: 1px solid #e4e7eb; padding-bottom: .35rem; }\n  a { color: #175b9c; }\n  form { background: #f8f9fb; border: 1px solid #e4e7eb; border-radius: .5rem; padding: 1.25rem 1.5rem; }\n  .field { display: grid; grid-template-columns: 9rem 1fr; gap: .75rem; align-items: center; margin-bottom: 1rem; }\n  label { font-weight: 600; }\n  input, select { font: inherit; padding: .4rem .55rem; border: 1px solid #cbd2d9; border-radius: .35rem; background: #fff; }\n  input:focus, select:focus { outline: 2px solid #9ec5fe; outline-offset: 1px; border-color: #175b9c; }\n  .hint { grid-column: 2; color: #616e7c; font-size: .9rem; margin: -.35rem 0 0; }\n  .actions { grid-column: 2; margin-top: .25rem; }\n  button { font: inherit; font-weight: 600; padding: .5rem 1.4rem; border: none; border-radius: .35rem; background: #175b9c; color: #fff; cursor: pointer; }\n  button:disabled { background: #9aa5b1; cursor: wait; }\n  .msg { margin: 1rem 0 0; padding: .6rem .9rem; border-radius: .35rem; display: none; }\n  .msg.show { display: block; }\n  .msg.error { background: #fde8e8; border: 1px solid #f5b5b5; color: #9b1c1c; }\n  .msg.ok { background: #e6f6ec; border: 1px solid #a7e0bd; color: #146134; }\n  table { width: 100%; border-collapse: collapse; font-size: .95rem; }\n  th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid #e4e7eb; vertical-align: top; }\n  th { color: #52606d; font-size: .85rem; white-space: nowrap; }\n  td.id, code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85rem; word-break: break-all; }\n  .empty { color: #616e7c; }\n  .skip-notice { background: #fff8e6; border: 1px solid #f0d48a; color: #7c4a03; padding: .6rem .9rem; border-radius: .35rem; margin: 0 0 1rem; }\n  .list-error { color: #9b1c1c; }\n  .badge { display: inline-block; padding: .05rem .55rem; border-radius: 999px; background: #fff3c4; color: #7c4a03; font-size: .85rem; }\n  .meta { color: #7b8794; font-size: .85rem; }\n</style>\n</head><body><main>\n  <h1>ScoreArena</h1>\n  <p class=\"sub\">桌面规则游戏与赛事管理</p>\n\n  <h2>创建公开房间</h2>\n  <form id=\"room-form\" novalidate=\"\">\n    <div class=\"field\">\n      <label for=\"name\">房间名称</label>\n      <input id=\"name\" name=\"name\" type=\"text\" autocomplete=\"off\" placeholder=\"1–40 个字符，首尾空白会被去掉\" required=\"\">\n      <p class=\"hint\">名称会去掉首尾空白后保存，内部空格保留；长度按 Unicode 字符计。原始输入不限长，整理后不超过 40 个字符即可。</p>\n    </div>\n    <div class=\"field\">\n      <label for=\"game\">游戏规则</label>\n      <select id=\"game\" name=\"game\" required=\"\">\n        <option value=\"\" selected=\"\">请选择游戏规则…</option>\n        <option value=\"gomoku\">五子棋（gomoku）</option>\n        <option value=\"ludo\">飞行棋（ludo）</option>\n      </select>\n    </div>\n    <div class=\"field\">\n      <label for=\"capacity\">人数上限</label>\n      <select id=\"capacity\" name=\"capacity\" required=\"\" disabled=\"\"><option value=\"\">请先选择游戏规则</option></select>\n      <p class=\"hint\" id=\"capacity-hint\">五子棋人数固定为 2 人；飞行棋允许 2 至 4 人。</p>\n    </div>\n    <div class=\"field\">\n      <label for=\"turnSeconds\">每步时间限制</label>\n      <input id=\"turnSeconds\" name=\"turnSeconds\" type=\"number\" step=\"1\" inputmode=\"numeric\" placeholder=\"秒，0 表示不限时\" required=\"\">\n      <p class=\"hint\">以秒为单位：填 <strong>0</strong> 表示不限时；其他值必须是 10 至 600 之间的整数。</p>\n    </div>\n    <div class=\"field\">\n      <div></div>\n      <div class=\"actions\">\n        <button type=\"submit\" id=\"submit\">创建房间</button>\n      </div>\n    </div>\n    <p class=\"msg\" id=\"form-msg\" role=\"alert\"></p>\n  </form>\n\n  <h2>房间列表</h2>\n  <div id=\"list-area\"><p class=\"skip-notice\">有 1 条房间记录无法作为房间显示，已跳过；原始数据仍保留在服务端，未被删除或改写。</p><table><thead><tr><th>房间编号</th><th>名称</th><th>规则</th><th>人数上限</th><th>时间限制</th><th>状态</th><th>创建时间</th></tr></thead><tbody><tr><td class=\"id\">morning-room</td><td>&lt;b&gt;晨间&lt;/b&gt; \"棋友\" &amp; 老友</td><td>五子棋</td><td>2 人</td><td>不限时</td><td><span class=\"badge\">未开始</span></td><td title=\"2026-02-03T08:30:00Z\">2026-02-03 16:30:00</td></tr><tr><td class=\"id\">字段格式异常</td><td>字段格式异常</td><td>字段格式异常</td><td>字段格式异常</td><td>字段格式异常</td><td><span class=\"badge\">字段格式异常</span></td><td>字段格式异常</td></tr><tr><td class=\"id\">evening-room</td><td>&amp;lt;晚间&amp;gt; &amp;amp; 棋友</td><td>飞行棋</td><td>3 人</td><td>60 秒</td><td><span class=\"badge\">playing</span></td><td title=\"2026-02-04T23:15:00Z\">2026-02-05 07:15:00</td></tr><tr><td class=\"id\">6e1259440d2488a6d1859c71ee173620</td><td>&lt;b&gt;晚间新局&lt;/b&gt; \"棋友\" &amp;amp;</td><td>飞行棋</td><td>4 人</td><td>60 秒</td><td><span class=\"badge\">未开始</span></td><td title=\"2026-10-05T16:31:17Z\">2026-10-06 00:31:17</td></tr></tbody></table></div>\n\n  <p class=\"meta\"><a href=\"/api/rooms\">查看房间列表接口</a> · <a href=\"/health\">服务状态</a></p>\n</main>\n\n<script>\n(function () {\n  var form = document.getElementById('room-form');\n  var gameSel = document.getElementById('game');\n  var capSel = document.getElementById('capacity');\n  var capHint = document.getElementById('capacity-hint');\n  var submitBtn = document.getElementById('submit');\n  var formMsg = document.getElementById('form-msg');\n  var listArea = document.getElementById('list-area');\n  var emptyTip = document.getElementById('empty-tip');\n\n  var GAME_LABELS = { gomoku: '五子棋', ludo: '飞行棋' };\n  var STATUS_LABELS = { waiting: '未开始' };\n\n  // 按所选规则重建人数上限选项。\n  function syncCapacity() {\n    var game = gameSel.value;\n    var prev = capSel.value;\n    capSel.innerHTML = '';\n    if (game === 'gomoku') {\n      capSel.disabled = false;\n      addOption('', '固定 2 人');\n      addOption('2', '2 人');\n      capSel.value = '2';\n      capHint.textContent = '五子棋人数上限固定为 2 人。';\n    } else if (game === 'ludo') {\n      capSel.disabled = false;\n      addOption('', '请选择人数上限…');\n      [2, 3, 4].forEach(function (n) { addOption(String(n), n + ' 人'); });\n      capSel.value = (prev === '2' || prev === '3' || prev === '4') ? prev : '';\n      capHint.textContent = '飞行棋人数上限允许 2 至 4 人。';\n    } else {\n      capSel.disabled = true;\n      addOption('', '请先选择游戏规则');\n      capHint.textContent = '五子棋人数固定为 2 人；飞行棋允许 2 至 4 人。';\n    }\n  }\n\n  function addOption(value, text) {\n    var opt = document.createElement('option');\n    opt.value = value;\n    opt.textContent = text;\n    capSel.appendChild(opt);\n  }\n\n  gameSel.addEventListener('change', syncCapacity);\n\n  function showMessage(kind, text) {\n    formMsg.className = 'msg show ' + kind;\n    formMsg.textContent = text;\n  }\n  function clearMessage() {\n    formMsg.className = 'msg';\n    formMsg.textContent = '';\n  }\n\n  // 与服务端 strings.TrimSpace（Go unicode.IsSpace）完全一致的首尾空白范围：\n  // 包含 U+0085、U+00A0 等，但不包含 U+FEFF（保留并计入长度）。\n  // 不能用 JS 自带的 trim()：它会多去掉 U+FEFF，又漏掉 U+0085。\n  var EDGE_SPACE = '[\\\\u0009-\\\\u000D\\\\u0020\\\\u0085\\\\u00A0\\\\u1680\\\\u2000-\\\\u200A\\\\u2028\\\\u2029\\\\u202F\\\\u205F\\\\u3000]';\n  var LEADING_SPACE = new RegExp('^' + EDGE_SPACE + '+');\n  var TRAILING_SPACE = new RegExp(EDGE_SPACE + '+$');\n  function trimName(value) {\n    return value.replace(LEADING_SPACE, '').replace(TRAILING_SPACE, '');\n  }\n\n  // 与服务端一致的提交前校验；服务端仍会再次校验。\n  // 输入表单原始值，返回 { error } 或 { payload }：漏填要明确报错，绝不补默认值；\n  // 名称只含会被去掉的首尾空白时同样视为空。通过校验的 payload 中名称仍是\n  // 用户原始输入（不由页面整理），时间与人数各只转换一次。\n  function checkForm(raw) {\n    var nameLen = Array.from(trimName(raw.name)).length;\n    if (nameLen === 0) return { error: '房间名称不能为空。' };\n    if (!raw.game) return { error: '请选择游戏规则。' };\n    if (raw.capacity === '') return { error: '请选择人数上限。' };\n    if (raw.turnSeconds === '') return { error: '请填写每步时间限制（0 表示不限时）。' };\n    if (!/^-?\\d+$/.test(raw.turnSeconds)) return { error: '时间限制必须是整数秒，不能含小数。' };\n\n    // 通过必填与整数格式检查后再转换：空值不会变成 0，不合法文字不会变成秒数。\n    var capacity = parseInt(raw.capacity, 10);\n    var turnSeconds = Number(raw.turnSeconds);\n\n    if (nameLen > 40) return { error: '房间名称去掉首尾空白后不能超过 40 个字符。' };\n    if (raw.game !== 'gomoku' && raw.game !== 'ludo') return { error: '请选择游戏规则。' };\n    if (raw.game === 'gomoku' && capacity !== 2) return { error: '五子棋的人数上限固定为 2 人。' };\n    if (raw.game === 'ludo' && !(capacity >= 2 && capacity <= 4)) {\n      return { error: '飞行棋的人数上限必须为 2 至 4 人。' };\n    }\n    if (turnSeconds !== 0 && !(turnSeconds >= 10 && turnSeconds <= 600)) {\n      return { error: '每步时间限制只能填 0（不限时）或 10 至 600 之间的整数秒。' };\n    }\n\n    return {\n      payload: {\n        name: raw.name,\n        game: raw.game,\n        capacity: capacity,\n        turnSeconds: turnSeconds\n      }\n    };\n  }\n\n  form.addEventListener('submit', function (event) {\n    event.preventDefault();\n    clearMessage();\n\n    var result = checkForm({\n      name: document.getElementById('name').value,\n      game: gameSel.value,\n      capacity: capSel.value,\n      turnSeconds: document.getElementById('turnSeconds').value.trim()\n    });\n    if (result.error) { showMessage('error', result.error); return; }\n\n    submit(result.payload);\n  });\n\n  function submit(payload) {\n    submitBtn.disabled = true;\n    fetch('/api/rooms', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(payload)\n    }).then(function (resp) {\n      return resp.json().catch(function () { return {}; }).then(function (data) {\n        return { ok: resp.ok, status: resp.status, data: data };\n      });\n    }).then(function (result) {\n      if (result.ok && result.status === 201) {\n        showMessage('ok', '房间已创建，编号：' + result.data.id);\n        form.reset();\n        syncCapacity();\n        return loadRooms();\n      }\n      // 创建失败：保留填写内容，仅显示原因。\n      var reason = result.data && result.data.error ? result.data.error\n                 : ('创建失败（HTTP ' + result.status + '）');\n      showMessage('error', reason);\n    }).catch(function () {\n      showMessage('error', '无法连接服务，请确认服务仍在运行后重试。');\n    }).finally(function () {\n      submitBtn.disabled = false;\n    });\n  }\n\n  function formatTime(iso) {\n    var d = new Date(iso);\n    if (isNaN(d.getTime())) return iso;\n    var pad = function (n) { return String(n).padStart(2, '0'); };\n    var text = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +\n      ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());\n    return { text: text, title: iso };\n  }\n\n  // 只有 JSON 对象能作为房间行；null、字符串、数字、布尔值和数组都跳过。\n  // 不按创建表单的规则重新判定历史记录：对象带多少附加字段都照常展示，\n  // 也不检查其字段是否完整或合法（各单元格沿用现有兜底显示）。\n  function isRoomRecord(value) {\n    return value !== null && typeof value === 'object' && !Array.isArray(value);\n  }\n\n  function appendSkipNotice(skipped, allSkipped) {\n    var p = document.createElement('p');\n    p.className = 'skip-notice';\n    if (allSkipped) {\n      p.textContent = '没有可展示的房间。本次返回的房间记录中有 ' + skipped +\n        ' 条无法作为房间显示，已全部跳过；原始数据仍保留在服务端，未被删除或改写。';\n    } else {\n      p.textContent = '有 ' + skipped + ' 条房间记录无法作为房间显示，已跳过；' +\n        '原始数据仍保留在服务端，未被删除或改写。';\n    }\n    listArea.appendChild(p);\n  }\n\n  // 历史记录的某个展示字段若被存成 JSON 对象或数组，该单元格统一显示\n  // “字段格式异常”，不展开其内部内容；异常只影响所在单元格，绝不能抛出\n  // 异常拖垮整行乃至整份列表。null、字符串、数字、布尔值及缺失字段都不算\n  // 异常，仍走各列原有的展示与兜底。\n  var BAD_FIELD_TEXT = '字段格式异常';\n  function isAbnormalField(value) {\n    return value !== null && typeof value === 'object';\n  }\n  function markBadCell(td) {\n    td.textContent = BAD_FIELD_TEXT;\n  }\n\n  function appendBadge(td, text) {\n    var badge = document.createElement('span');\n    badge.className = 'badge';\n    badge.textContent = text;\n    td.appendChild(badge);\n  }\n\n  // 七列的展示定义，顺序即表格列顺序（表头也由同一份定义生成）。每列只\n  // 描述“正常值如何显示”（含各列原有的兜底行为）；对象/数组的异常判定\n  // 与替换由 buildRoomRow 统一处理，不在各列重复维护。个别列可用\n  // renderBad 保留原有容器（如状态列的徽标），缺省时整格替换为异常文案。\n  var ROOM_COLUMNS = [\n    {\n      key: 'id',\n      label: '房间编号',\n      className: 'id',\n      render: function (td, value) { td.textContent = value || ''; }\n    },\n    {\n      key: 'name',\n      label: '名称',\n      render: function (td, value) { td.textContent = value || ''; }\n    },\n    {\n      key: 'game',\n      label: '规则',\n      render: function (td, value) {\n        td.textContent = GAME_LABELS[value] || value || '';\n      }\n    },\n    {\n      key: 'capacity',\n      label: '人数上限',\n      render: function (td, value) {\n        td.textContent = (value != null ? value : '') + ' 人';\n      }\n    },\n    {\n      key: 'turnSeconds',\n      label: '时间限制',\n      render: function (td, value) {\n        td.textContent = value === 0 ? '不限时' : value + ' 秒';\n      }\n    },\n    {\n      key: 'status',\n      label: '状态',\n      render: function (td, value) {\n        appendBadge(td, STATUS_LABELS[value] || value || '');\n      },\n      // 异常状态仍在原有徽标中显示提示文案。\n      renderBad: function (td) { appendBadge(td, BAD_FIELD_TEXT); }\n    },\n    {\n      key: 'createdAt',\n      label: '创建时间',\n      render: function (td, value) {\n        var t = formatTime(value || '');\n        td.textContent = t.text;\n        td.title = t.title;\n      }\n      // 无 renderBad：异常创建时间只显示异常文案，不附加日期悬浮说明\n      // （不设置 title）。\n    }\n  ];\n\n  // 逐列渲染一个房间行：任何字段异常都只替换该单元格，其余字段照常显示。\n  function buildRoomRow(r) {\n    var tr = document.createElement('tr');\n    ROOM_COLUMNS.forEach(function (col) {\n      var td = document.createElement('td');\n      if (col.className) td.className = col.className;\n      var value = r[col.key];\n      if (isAbnormalField(value)) {\n        if (col.renderBad) col.renderBad(td);\n        else markBadCell(td);\n      } else {\n        col.render(td, value);\n      }\n      tr.appendChild(td);\n    });\n    return tr;\n  }\n\n  function renderRooms(rooms) {\n    listArea.innerHTML = '';\n\n    var validRooms = [];\n    var skipped = 0;\n    rooms.forEach(function (r) {\n      if (isRoomRecord(r)) validRooms.push(r);\n      else skipped++;\n    });\n\n    if (!validRooms.length) {\n      if (skipped > 0) {\n        appendSkipNotice(skipped, true);\n      } else {\n        var pEmpty = document.createElement('p');\n        pEmpty.className = 'empty';\n        pEmpty.textContent = '还没有房间记录。';\n        listArea.appendChild(pEmpty);\n      }\n      return;\n    }\n\n    if (skipped > 0) appendSkipNotice(skipped, false);\n\n    var table = document.createElement('table');\n    var thead = document.createElement('thead');\n    var headRow = document.createElement('tr');\n    ROOM_COLUMNS.forEach(function (col) {\n      var th = document.createElement('th');\n      th.textContent = col.label;\n      headRow.appendChild(th);\n    });\n    thead.appendChild(headRow);\n    table.appendChild(thead);\n    var tbody = document.createElement('tbody');\n    validRooms.forEach(function (r) {\n      tbody.appendChild(buildRoomRow(r));\n    });\n    table.appendChild(tbody);\n    listArea.appendChild(table);\n  }\n\n  // 列表查询序号：每次发起查询递增，只有当前最新一次查询的结果\n  // （无论成功还是失败）允许更新列表区域；较早查询后返回的结果一律忽略，\n  // 防止旧数据覆盖新查询已展示的列表。\n  var listQuerySeq = 0;\n\n  function loadRooms() {\n    var seq = ++listQuerySeq;\n    return fetch('/api/rooms', { headers: { 'Accept': 'application/json' } })\n      .then(function (resp) {\n        if (!resp.ok) throw new Error('HTTP ' + resp.status);\n        return resp.json();\n      })\n      .then(function (data) {\n        if (seq !== listQuerySeq) return;\n        var rooms = Array.isArray(data && data.rooms) ? data.rooms : [];\n        renderRooms(rooms);\n      })\n      .catch(function () {\n        if (seq !== listQuerySeq) return;\n        listArea.innerHTML = '';\n        var p = document.createElement('p');\n        p.className = 'list-error';\n        p.textContent = '房间列表加载失败，请稍后刷新重试。已有数据不会因此丢失。';\n        listArea.appendChild(p);\n      });\n  }\n\n  syncCapacity();\n  loadRooms();\n})();\n</script>\n\n</body></html>\n","outputBase64":""}
